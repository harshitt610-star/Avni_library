# ==============================================================================
# STORYNEST LITERARY PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/storynest?retryWrites=true&w=majority"

# JWT Secret for Session Cookies & RBAC Authentication (use a 64+ char random string in production)
JWT_SECRET="your_production_secure_jwt_secret_key_minimum_64_characters"

# Base Application URL (used for CORS, canonical URLs, and redirects)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Confidential Testing Phase Access Key (Secret - Verified on server only)
TESTING_PHASE_PASSWORD="StoryNest_Test_2026_Secure!"

# Node Environment
NODE_ENV="production"

